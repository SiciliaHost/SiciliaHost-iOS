default_platform(:ios)

platform :ios do
  desc "Compila, firma e carica l'app su Apple TestFlight"
  lane :beta do
    # Connessione ad App Store Connect tramite API Key
    api_key = app_store_connect_api_key(
      key_id: ENV["APP_STORE_CONNECT_KEY_ID"],
      issuer_id: ENV["APP_STORE_CONNECT_ISSUER_ID"],
      key_content: ENV["APP_STORE_CONNECT_PRIVATE_KEY"],
      is_key_content_base64: false
    )

    # Verifica o crea la scheda app su App Store Connect
    begin
      app = Spaceship::ConnectAPI::App.find("com.siciliahost.cactushost")
      if app
        UI.message("Scheda app trovata su App Store Connect: #{app.name} (ID: #{app.id})")
      else
        UI.message("Creazione nuova scheda app su App Store Connect...")
        app = Spaceship::ConnectAPI::App.create(
          name: "CactusHost",
          version_string: "1.0",
          sku: "cactushost_ios",
          primary_locale: "it-IT",
          bundle_id: "com.siciliahost.cactushost"
        )
        UI.message("Scheda app creata con successo: #{app.name} (ID: #{app.id})")
      end
    rescue => ex
      UI.message("Nota verifica scheda app: #{ex.message}")
    end

    # Crea portachiavi temporaneo per la CI sul runner macOS
    keychain_name = "ci_keychain"
    keychain_password = "ci_keychain_password_123"
    keychain_path = File.expand_path("~/Library/Keychains/#{keychain_name}-db")
    create_keychain(
      name: keychain_name,
      password: keychain_password,
      default_keychain: true,
      unlock: true,
      timeout: 3600
    )

    # Gestione certificati di distribuzione: se il limite Apple (2) è raggiunto,
    # revoca il certificato più vecchio (orfano senza chiave privata sulla CI) per liberare lo slot
    begin
      all_certs = Spaceship::ConnectAPI::Certificate.all
      dist_certs = all_certs.select { |c| c.certificate_type.to_s.include?("DISTRIBUTION") }
      UI.message("Trovati #{dist_certs.count} certificati di distribuzione su Apple Developer.")
      if dist_certs.count >= 2
        oldest = dist_certs.sort_by { |c| c.expiration_date.to_s }.first
        UI.message("Revoca del certificato più vecchio #{oldest.id} (#{oldest.name}, scadenza #{oldest.expiration_date}) per liberare lo slot...")
        oldest.delete!
        UI.message("Certificato #{oldest.id} revocato con successo.")
      end
    rescue => ex
      UI.message("Nota pulizia certificati: #{ex.message}")
    end

    # Scarica o genera il certificato Apple Distribution nel portachiavi
    get_certificates(
      api_key: api_key,
      keychain_path: keychain_path,
      keychain_password: keychain_password
    )

    # Scarica o genera il provisioning profile per TestFlight (default: App Store)
    get_provisioning_profile(
      api_key: api_key,
      app_identifier: "com.siciliahost.cactushost"
    )

    build_number = ENV["FL_BUILD_NUMBER"] || "1"

    # Compila ed esporta il pacchetto .ipa firmato per App Store / TestFlight
    build_app(
      project: "SiciliaHost.xcodeproj",
      scheme: "SiciliaHost",
      export_method: "app-store",
      output_directory: "build/testflight",
      output_name: "CactusHost.ipa",
      clean: false,
      xcargs: "CURRENT_PROJECT_VERSION=#{build_number}"
    )

    # Carica direttamente su TestFlight
    upload_to_testflight(
      api_key: api_key,
      ipa: "build/testflight/CactusHost.ipa",
      skip_waiting_for_build_processing: true
    )
  end
end
